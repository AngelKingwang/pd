<view class="page">
  <!-- 图片展示区 -->
  <view class="canvas-wrap" style="height: {{canvasHeight}}px">
    <canvas
      type="2d"
      id="mainCanvas"
      class="main-canvas"
      disable-scroll="{{true}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    >
      <!-- canvas 是原生组件，按钮用 cover-view 放在其内部才不会被遮挡 -->
      <cover-view class="import-btn" bindtap="chooseImage">导入图片</cover-view>

      <cover-view class="zoom-btns" wx:if="{{hasImage && !cropMode}}">
        <cover-view class="zoom-btn" bindtap="zoomIn">+</cover-view>
        <cover-view class="zoom-btn" bindtap="zoomOut">−</cover-view>
        <cover-view class="zoom-btn fit" bindtap="fitView">适配</cover-view>
      </cover-view>

      <cover-view class="empty-tip" wx:if="{{!hasImage}}">点击右上角「导入图片」，支持十字绣 / 拼豆图纸</cover-view>

      <cover-view class="crop-tip" wx:if="{{cropMode}}">拖动调整裁剪框，裁掉色卡和边缘数字，再点「完成裁剪」</cover-view>
    </canvas>
  </view>

  <!-- 工具栏 -->
  <view class="toolbar" wx:if="{{hasImage}}">
    <view class="tool-btn {{cropMode ? 'active' : ''}}" bindtap="toggleCrop">{{cropMode ? '完成裁剪' : '裁剪'}}</view>
    <view class="tool-btn" bindtap="autoGrid">自动网格</view>
    <view class="tool-btn {{calibMode ? 'active' : ''}}" bindtap="toggleCalib">校准</view>
    <view class="grid-input">
      <text>列</text>
      <input type="number" value="{{gridCols}}" bindblur="onColsBlur" />
      <text>行</text>
      <input type="number" value="{{gridRows}}" bindblur="onRowsBlur" />
    </view>
    <view class="tool-btn" bindtap="reExtract">重新取色</view>
  </view>

  <!-- 网格校准面板：网格线和图纸没对齐时微调 -->
  <view class="calib-panel" wx:if="{{hasImage && calibMode}}">
    <text class="calib-label">位置</text>
    <view class="calib-btn" data-dx="-1" bindtap="nudge">←</view>
    <view class="calib-btn" data-dx="1" bindtap="nudge">→</view>
    <view class="calib-btn" data-dy="-1" bindtap="nudge">↑</view>
    <view class="calib-btn" data-dy="1" bindtap="nudge">↓</view>
    <text class="calib-label">格宽</text>
    <view class="calib-btn" data-dw="-0.5" bindtap="nudge">−</view>
    <view class="calib-btn" data-dw="0.5" bindtap="nudge">+</view>
    <text class="calib-label">格高</text>
    <view class="calib-btn" data-dh="-0.5" bindtap="nudge">−</view>
    <view class="calib-btn" data-dh="0.5" bindtap="nudge">+</view>
  </view>

  <view class="info-bar" wx:if="{{hasImage}}">
    {{gridCols}} × {{gridRows}} 格 · {{palette.length}} 种颜色{{selectedColor !== null ? ' · 已选中 ' + palette[selectedColor].num + ' 号色' : ''}}
  </view>

  <!-- 颜色块列表 -->
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="palette" wx:if="{{palette.length}}">
    <view class="palette-inner">
      <view
        class="palette-item {{selectedColor === index ? 'selected' : ''}}"
        wx:for="{{palette}}"
        wx:key="num"
        data-idx="{{index}}"
        bindtap="onColorTap"
      >
        <text class="palette-num">{{item.num}}</text>
        <view class="palette-block" style="background: {{item.css}}"></view>
        <text class="palette-count">{{item.count}}格</text>
      </view>
    </view>
  </scroll-view>
</view>
