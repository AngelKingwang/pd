.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 图片展示区 */
.canvas-wrap {
  position: relative;
  width: 100%;
  background: #e8eaed;
  overflow: hidden;
  flex-shrink: 0;
}

.main-canvas {
  width: 100%;
  height: 100%;
}

.import-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 12rpx 28rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
}

.import-btn:active {
  opacity: 0.8;
}

.zoom-btns {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 10;
}

.zoom-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  font-size: 40rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.zoom-btn.fit {
  font-size: 24rpx;
}

.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.crop-tip {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  z-index: 10;
}

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  gap: 16rpx;
  background: #fff;
  flex-shrink: 0;
}

.tool-btn {
  padding: 10rpx 24rpx;
  background: #f2f3f5;
  color: #333;
  font-size: 26rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.tool-btn.active {
  background: #07c160;
  color: #fff;
}

.grid-input {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.grid-input input {
  width: 90rpx;
  height: 52rpx;
  background: #f2f3f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}

.info-bar {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: #999;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

/* 颜色块列表 */
.palette {
  flex: 1;
  width: 100%;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  white-space: nowrap;
}

.palette-inner {
  display: inline-flex;
  padding: 20rpx 16rpx;
  gap: 16rpx;
}

.palette-item {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.palette-item.selected {
  border-color: #07c160;
  background: #e8f9f0;
}

/* 数字在颜色块左边 */
.palette-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  min-width: 36rpx;
  text-align: right;
}

.palette-block {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.palette-count {
  font-size: 20rpx;
  color: #999;
}
